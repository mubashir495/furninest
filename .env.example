# LUXA FURNITURE Frontend — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# URL of the NestJS backend API for server-side ISR data fetching (no trailing slash)
BACKEND_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Canonical site URL used for Open Graph, JSON-LD and metadata
NEXT_PUBLIC_SITE_URL=https://luxafurniture.co.uk

# Secret key for on-demand ISR cache revalidation (must match backend REVALIDATE_SECRET)
# Generated using a strong random key (e.g. openssl rand -hex 32)
REVALIDATE_SECRET=your-secure-revalidation-secret-at-least-32-chars
