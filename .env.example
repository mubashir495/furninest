# LUXA FURNITURE Frontend — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# URL of the NestJS backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Canonical site URL used for Open Graph, JSON-LD and sitemap generation
NEXT_PUBLIC_SITE_URL=https://luxafurniture.co.uk
